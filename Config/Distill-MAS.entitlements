<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store build. Identical in content to the Direct build:
	     the GUI only ever touches files and folders the user hands it,
	     via NSOpenPanel grants and security-scoped bookmarks.
	     Deliberately absent:
	     - files.bookmarks.app-scope — not required on current macOS;
	       bookmark restore is verified working without it.
	     - anything that existed to serve the CLI/MCP helper; that helper
	       is not part of this build (see the Embed CLI guard phase).
	     Kept as a separate file so MAS entitlements can be audited and
	     can diverge without touching the Direct build. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
